package lesson_6.interface2;

public abstract class Parallelogram  implements Figure{
     // Длина стороны ромба
    double height;
    // Высота ромба
    double width;

  
   public Parallelogram(double height, double width) {
        this.height = height;
        this.width=width;
    }
   
   @Override
    public double getArea() {
        return height * width;
    }
    
   
}
