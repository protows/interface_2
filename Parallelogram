package lesson_6.interface2;

public abstract class Parallelogram  implements Figure{
     // Длина стороны ромба
    double a=0.00;
    // Высота ромба
    double h=0.00;

  public Parallelogram(double a) {
        this.a = a;
    }
  
   public Parallelogram(double a, double h) {
        this.a = a;
        this.h =h;
    }
    
   
}
